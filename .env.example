# Copy to .env. Nothing here is required: with no model configured the agents
# run in deterministic *template* mode (useful for CI, offline demos and as the
# failure-recovery path when a model call fails or produces ungrounded output).

# --- Option A: Microsoft Foundry project (recommended for the hackathon) -----
# Uses DefaultAzureCredential (az login / managed identity). Needs the
# "Azure AI User" role on the project for the signed-in identity.
# FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
# FOUNDRY_MODEL=gpt-4.1-mini

# --- Option B: Azure OpenAI / Foundry model endpoint with a key or identity ---
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_MODEL=gpt-4.1-mini          # deployment name
# AZURE_OPENAI_API_KEY=...                  # omit to use DefaultAzureCredential
# AZURE_OPENAI_API_VERSION=2024-10-21

# --- Option C: OpenAI-compatible key (local dev only) ------------------------
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4.1-mini

# Force template mode even if credentials are present (CI / cost control)
# SISYPHUS_FORCE_TEMPLATE=1

# Where generated matches live
SISYPHUS_DATA_DIR=data/generated
# Where the Streamlit UI finds the API
SISYPHUS_API_URL=http://localhost:8000
